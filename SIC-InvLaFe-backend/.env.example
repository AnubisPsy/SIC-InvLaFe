# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore porque contiene la clave secreta del proyecto.

# --- Supabase ---------------------------------------------------------------

# Project Settings → Data API → Project URL
SUPABASE_URL=https://tuproyecto.supabase.co

# Project Settings → API Keys → Secret key / service_role (sb_secret_... )
#
# Esta clave IGNORA por completo las políticas RLS: puede leer y escribir
# cualquier fila y administrar las cuentas de Auth. Vive solo aquí, nunca en el
# frontend ni en un repositorio.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Project Settings → API Keys → Publishable key (sb_publishable_... )
#
# La misma que usa el frontend en VITE_SUPABASE_PUBLISHABLE_KEY. No es secreta.
# La necesita el login por nombre de usuario: tras traducir el nombre a correo
# con la clave de arriba, la autenticación se hace con esta, para que la sesión
# emitida tenga exactamente los mismos privilegios que si hubiera entrado el
# navegador por su cuenta.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Servidor ---------------------------------------------------------------

PORT=3000

# `development` relaja algunos mensajes de error para depurar. En el servidor
# de producción debe ser `production`.
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas. Debe incluir la URL exacta
# desde la que se sirve el frontend (protocolo + host + puerto, sin barra final).
CORS_ORIGENES=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL=postgres://sic:contrasena@192.168.1.201:5432/sic_invlafe

# --- Sesiones (JWT) ----------------------------------------------------------
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_DURACION=8h
