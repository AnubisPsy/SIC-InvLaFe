# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore: nunca lo subas al repositorio.
#
# Este archivo es para desarrollo (npm run dev). En el servidor, con Docker,
# las variables van en el `.env` de la raíz del repositorio.

# --- Base de datos ------------------------------------------------------------

# postgres://usuario:contraseña@servidor:puerto/base
# Si la contraseña tiene símbolos como @ : / # ? &, escríbelos codificados
# (por ejemplo @ es %40), o usa una contraseña de solo letras y números.
DATABASE_URL=postgres://sic:tu_contrasena@192.168.1.201:5432/sic_invlafe

# --- Sesiones (JWT) ----------------------------------------------------------

# Clave con la que se firman los tokens. Al menos 32 caracteres aleatorios.
# Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si la cambias, todas las sesiones abiertas se cierran.
JWT_SECRETO=

# Cuánto dura una sesión antes de pedir iniciar sesión otra vez.
JWT_DURACION=8h

# --- Servidor ---------------------------------------------------------------

PORT=3000

# `development` relaja algunos mensajes de error para depurar. En el servidor
# de producción debe ser `production`.
NODE_ENV=development

# Orígenes extra permitidos por CORS, separados por comas (protocolo + host +
# puerto, sin barra final). En desarrollo, el de Vite.
CORS_ORIGENES=http://localhost:5173
