{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "types": ["vite/client"],
    // Sin `baseUrl` (deprecado en TS 6): las rutas se resuelven relativas a este archivo.
    "paths": {
      "@/*": ["./src/*"],
      "@invlafe/core": ["../../packages/core/src/index.ts"],
      "@invlafe/query": ["../../packages/query/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/query" }
  ]
}
