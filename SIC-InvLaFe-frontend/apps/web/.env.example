# Copia este archivo a `.env` (en esta misma carpeta) y rellena el valor.
# `.env` está en .gitignore: nunca lo subas al repositorio.

# Dirección del backend (repositorio SIC-InvLaFe-backend), sin barra final.
# En desarrollo, el puerto por defecto del backend es el 3000.
# En Docker no se usa este archivo: la imagen compila con VITE_API_URL=/, que
# significa "el mismo servidor que sirve la página" (nginx reenvía /api).
VITE_API_URL=http://localhost:3000
