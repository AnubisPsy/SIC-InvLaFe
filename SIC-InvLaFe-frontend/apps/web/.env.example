# Credenciales del proyecto de Supabase.
# Copia este archivo a `.env` (en esta misma carpeta) y rellena los valores.
# `.env` está en .gitignore: nunca lo subas al repositorio.

# Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://tuproyecto.supabase.co

# Project Settings → API Keys → Publishable key (sb_publishable_...)
# Es una clave pública, pensada para el navegador: RLS es lo que protege los datos.
# NO uses aquí la service_role / secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL del backend administrativo (repositorio SIC-InvLaFe-backend), sin barra
# final. Solo se usa para crear, editar y eliminar usuarios: esas operaciones
# necesitan la service_role key de Supabase, que no puede vivir en el navegador.
# En desarrollo, el puerto por defecto del backend es el 3000.
VITE_API_URL=http://localhost:3000
