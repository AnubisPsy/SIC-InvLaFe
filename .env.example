# Variables para `docker compose` en el servidor.
# Copia este archivo a `.env` (en esta misma carpeta, junto a compose.yaml) y
# rellena los valores. `.env` está en .gitignore: nunca lo subas.

# Conexión a PostgreSQL. `host.docker.internal` es el propio servidor visto
# desde dentro del contenedor. Usa la misma contraseña de ~/postgres/.env.
# Si la contraseña tiene símbolos como @ : / # ? &, escríbelos codificados
# (por ejemplo @ es %40).
DATABASE_URL=postgres://sic:tu_contrasena@host.docker.internal:5432/sic_invlafe

# Al menos 32 caracteres aleatorios. Genérala en el servidor con:
#   openssl rand -hex 48
# Usa una distinta de la de desarrollo. Si la cambias, se cierran todas las sesiones.
JWT_SECRETO=

# Cuánto dura una sesión.
JWT_DURACION=8h

# Puerto del servidor donde se abre la app: http://192.168.1.201:8081
PUERTO_WEB=8081

# Orígenes extra que pueden llamar a la API (separados por comas). Déjalo
# vacío: la app servida por nginx no lo necesita.
CORS_ORIGENES=
